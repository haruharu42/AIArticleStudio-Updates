# Server-side Worker bindings for local TEST-mode billing only.
# Copy to .dev.vars locally. Never commit real secret values.
AAS_COMMERCE_MODE=off
AAS_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Public API key used only to validate user access tokens with Supabase Auth.
AAS_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-only elevated key used for billing RPCs and protected data access.
AAS_SUPABASE_SERVICE_ROLE_KEY=REPLACE_LOCALLY_ONLY
AAS_STRIPE_SECRET_KEY=sk_test_REPLACE_LOCALLY_ONLY
AAS_STRIPE_WEBHOOK_SECRET=whsec_REPLACE_LOCALLY_ONLY

# Stripe Price IDs are the pricing source of truth. Do not hard-code prices in the app.
AAS_STRIPE_PRICE_PWA_7D=price_REPLACE_ME
AAS_STRIPE_PRICE_PWA_MONTHLY=price_REPLACE_ME
AAS_STRIPE_PRICE_WINDOWS_MONTHLY=price_REPLACE_ME
AAS_STRIPE_PRICE_BUNDLE_MONTHLY=price_REPLACE_ME

# Seller disclosure mode.
# individual + on_request keeps name/address/phone out of /api/billing/config and the public page,
# while requiring the real information to remain configured server-side for disclosure requests.
# business/public displays the configured seller information directly.
AAS_SELLER_TYPE=individual
AAS_SELLER_DISCLOSURE_MODE=on_request

# Required before AAS_COMMERCE_MODE=live.
# For individual/on_request, NAME/ADDRESS/PHONE remain server-side and must be available for disclosure.
# EMAIL and SUPPORT_URL are public contact points.
AAS_SELLER_NAME=
AAS_SELLER_ADDRESS=
AAS_SELLER_PHONE=
AAS_SELLER_EMAIL=
AAS_SUPPORT_URL=