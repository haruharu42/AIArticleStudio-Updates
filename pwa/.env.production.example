# Production-only public configuration template.
# Copy values into the deployment environment. Do not commit real credentials.

# Canonical HTTPS origin for the deployed PWA, for example:
# AAS_PWA_PRODUCTION_ORIGIN=https://your-worker.workers.dev
AAS_PWA_PRODUCTION_ORIGIN=

# Browser-visible Supabase settings only.
NEXT_PUBLIC_AAS_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_AAS_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# These must be public HTTPS pages before production release.
NEXT_PUBLIC_AAS_TERMS_URL=
NEXT_PUBLIC_AAS_PRIVACY_URL=
NEXT_PUBLIC_AAS_AI_TERMS_URL=

# Cloudflare deployment identity. Prefer `wrangler login` for a local/manual deploy.
# For non-interactive CI deployment, set these in the CI secret store instead.
CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=  # secret: never commit a real token
