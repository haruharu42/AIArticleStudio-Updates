# Browser-visible Supabase project settings only.
# Never place a service-role key or sb_secret_* key in this file.
NEXT_PUBLIC_AAS_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_AAS_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Public legal links displayed during registration.
# First-party routes are the default. Replace with HTTPS external URLs only if needed.
NEXT_PUBLIC_AAS_TERMS_URL=/terms
NEXT_PUBLIC_AAS_PRIVACY_URL=/privacy
NEXT_PUBLIC_AAS_AI_TERMS_URL=/ai-terms
